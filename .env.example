# Copy to .env.local (gitignored) for local dev, or set these in the deploy environment.

# Dev-only: render the app shell with a fake signed-in user (no real Firebase auth).
VITE_FAKE_AUTH=1

# Sentry error monitoring. The DSN is not a secret (it ships in the frontend) but is kept
# out of git so it can be rotated. If unset, Sentry is fully inert (nothing is sent).
# The deployed TMS build (npm run build) reads this from .env.local or the build env.
VITE_SENTRY_DSN=
# development | pilot | production  (default: development in dev, pilot in a build)
VITE_SENTRY_ENV=pilot
